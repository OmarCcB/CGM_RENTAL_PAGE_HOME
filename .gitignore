# ── Editor / IDE ─────────────────────────────────────────────────────────────
.claude/
.vscode/
.idea/

# ── Secretos y configuración local ───────────────────────────────────────────
.env
.env.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
*.egg-info/

# ── Archivos archivados / no parte de producción ─────────────────────────────
_archive/
_no_usado/

# ── Bases de datos locales SQLite ────────────────────────────────────────────
# Por defecto se ignoran todos los *.db, pero la BD oficial vive en data/cgm.db
# y SÍ debe versionarse (la app la usa directamente; el panel admin escribe ahí).
*.db
*.sqlite
*.sqlite3
!data/cgm.db

# ── Dumps / scripts SQL one-shot ─────────────────────────────────────────────
*.sql

# ── Excel: artefactos de importación y lockfiles ─────────────────────────────
*.xlsx
~$*

# ── Imágenes fuente pesadas (reemplazadas por WebP compresas) ────────────────
static/images/Fotos capacita/
static/images/Fotos*/

# ── Sistema operativo ────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini
start.sh
